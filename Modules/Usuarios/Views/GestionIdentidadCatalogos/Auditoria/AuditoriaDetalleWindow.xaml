<Window x:Class="GestLog.Modules.Usuarios.Views.GestionIdentidadCatalogos.Auditoria.AuditoriaDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GestLog.Converters"
        Title="Detalle del evento"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Style="{StaticResource ModalWindowBase}">

    <Window.Resources>
        <conv:NombreEntidadAuditadaConverter x:Key="NombreEntidadConverter"/>
        <Style x:Key="EtiquetaCampoStyle" TargetType="TextBlock" BasedOn="{StaticResource ThemeBodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValorCampoStyle" TargetType="TextBlock" BasedOn="{StaticResource ThemeBodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ModalOverlayBrush}" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border Style="{DynamicResource ThemeWelcomeCardStyle}"
                Padding="0"
                Margin="24"
                Width="760"
                MaxWidth="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.30" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <Border Grid.Row="0"
                        Padding="24,22,18,18"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔍"
                                       FontSize="20"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding EntidadAfectada, Converter={StaticResource NombreEntidadConverter}, Mode=OneWay}"
                                       Style="{DynamicResource ThemeSectionTitleStyle}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBlock Style="{DynamicResource ThemeSectionSubtitleStyle}"
                                       TextWrapping="Wrap"
                                       MaxWidth="620">
                                <Run Text="{Binding ClaveEntidad, Mode=OneWay}"/>
                                <Run Text="{Binding DescripcionEntidad, Mode=OneWay, StringFormat=' — {0}'}"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Click="BtnCerrar_Click"
                                ToolTip="Cerrar"
                                Style="{StaticResource ThemeCloseButtonStyle}"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <Grid Width="16" Height="16">
                                <Line X1="0" Y1="0" X2="16" Y2="16" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="16" Y1="0" X2="0" Y2="16" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Cuerpo -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                    <StackPanel Margin="24,20,24,24">
                        <Border Background="{DynamicResource BackgroundSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Fecha y hora" Style="{StaticResource EtiquetaCampoStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding FechaHora, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm:ss'}"
                                           Style="{StaticResource ValorCampoStyle}"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ejecutado por" Style="{StaticResource EtiquetaCampoStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding UsuarioResponsable, Mode=OneWay}"
                                           Style="{StaticResource ValorCampoStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Acción" Style="{StaticResource EtiquetaCampoStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{Binding Accion, Mode=OneWay}"
                                           Style="{StaticResource ValorCampoStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Código del registro" Style="{StaticResource EtiquetaCampoStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="{Binding ClaveEntidad, Mode=OneWay, TargetNullValue='(sin código)'}"
                                           Style="{StaticResource ValorCampoStyle}"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BackgroundSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="Qué cambió"
                                           Style="{DynamicResource ThemeSectionTitleStyle}"
                                           FontSize="16"
                                           Margin="0,0,0,14"/>
                                <!-- Solo lectura, pero seleccionable para poder copiar el detalle -->
                                <TextBox Text="{Binding Detalle, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="90"
                                         MaxHeight="260"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextBodyBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie -->
                <Border Grid.Row="2"
                        Padding="24"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copiar detalle"
                                Click="BtnCopiar_Click"
                                Width="150"
                                Height="40"
                                Margin="0,0,12,0"
                                Style="{StaticResource ThemeSecondaryButtonStyle}"/>
                        <Button Content="Cerrar"
                                Click="BtnCerrar_Click"
                                Width="122"
                                Height="40"
                                Style="{StaticResource ThemePrimaryButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
